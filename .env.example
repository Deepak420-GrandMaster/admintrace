# AdminTrace configuration.
# Copy to .env and edit. Every value here is read by app/config.py and by
# nothing else in the codebase.

# ---------------------------------------------------------------------------
# Chat model
# ---------------------------------------------------------------------------

# Which provider answers and translates: "groq" (hosted API) or "ollama"
# (local). Nothing outside app/llm/ branches on this value.
LLM_PROVIDER=groq

# --- Groq -------------------------------------------------------------------
# Secret. Belongs in .env only, which is gitignored. Never in source, never
# committed, never in a workflow file — CI reads it from GitHub Actions
# secrets. Left empty here on purpose.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Must be a plain chat model. The groq/compound* models browse the web, which
# would let facts reach an answer without passing through retrieval; config.py
# refuses them outright.
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning models think before answering, and that thinking is charged to the
# same token budget as the answer. Keep this low unless answers get worse:
# at the default setting a short request can return nothing at all.
# One of: low, medium, high. Ignored by models that do not reason.
GROQ_REASONING_EFFORT=low

# --- Ollama (local, used when LLM_PROVIDER=ollama) ---------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral-small

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------

# Always local: no hosted provider configured here serves a multilingual
# embedding model, and an English-first model fails on French administrative
# vocabulary. "sentence-transformers" downloads the model once and runs it
# in-process; "ollama" pulls it through a local Ollama daemon instead.
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------

# How many chunks survive fusion and are offered to the answer layer.
RETRIEVAL_K=6

# Relative influence of the two retrievers during reciprocal rank fusion.
DENSE_WEIGHT=0.5
KEYWORD_WEIGHT=0.5

# Chunks scoring below this are dropped before they can reach the prompt.
# If nothing survives, the system refuses instead of guessing. Raising this
# makes refusals more common; lowering it risks answering from weak context.
RELEVANCE_THRESHOLD=0.35

# Second gate stage. Similarity measures topical closeness, not whether the
# passages answer the question, and measured against this corpus no single
# threshold separates the two. This asks the model that one question. It can
# only remove an answer, never add one. Turning it off makes refusals far
# rarer and less trustworthy.
ANSWERABILITY_CHECK=true

# Every answer's claims are checked against the evidence before a reader sees
# them; unsupported and contradicted claims are removed. Exists so a test can
# prove the check is what removes a bad claim. Keep it true.
CLAIM_VALIDATION=true

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------

# Size target. Structural rules win over it: a list of required documents or a
# numbered procedure is never split, however long it runs.
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=1200

# Hard ceiling of the embedding model. A chunk longer than this is truncated
# when embedded, which loses content silently, so chunking treats it as a
# limit it may never cross.
EMBED_MAX_TOKENS=8192

# How many chunks are embedded at once. Lower it if memory is tight.
EMBED_BATCH_SIZE=128

# Chunks are grouped so that batch size times longest sequence stays under this
# budget. A transformer pads every sequence in a batch to the longest one, so
# without this a single long passage makes the whole batch as expensive as if
# every passage were long, and can exhaust GPU memory.
EMBED_TOKEN_BUDGET=24576

# Half precision on GPU: less memory, faster, no meaningful effect on cosine
# ranking. Set false if you see degraded retrieval.
EMBED_HALF_PRECISION=true

# Name of the collection inside the vector store.
COLLECTION_NAME=reperes

# ---------------------------------------------------------------------------
# Source feed  (DILA open data, published under Licence Ouverte)
# ---------------------------------------------------------------------------

# Feed version. DILA serves several concurrently and retires old ones, so this
# is deliberately configurable rather than baked into the fetcher.
FEED_VERSION=3.5

# Feed endpoints. {version} and {segment} are substituted by app/ingest/fetch.py.
FEED_URL_TEMPLATE=https://lecomarquage.service-public.gouv.fr/vdd/{version}/{segment}/zip/vosdroits-latest.zip

# Which audiences to ingest. "part" = Particuliers, "pro" = Entreprendre.
FEED_SEGMENTS=part,pro

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

DATA_DIR=./data
CHROMA_DIR=./data/chroma

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# auto = answer in whatever language the question was asked in.
# Force with "en" or "fr".
ANSWER_LANGUAGE=auto

# The retrieval panel: detected language, translated query, per-passage
# scores, gate decision. A developer's view — off for readers.
DEBUG_PANEL=false

# ---------------------------------------------------------------------------
# Bug reports
# ---------------------------------------------------------------------------

# A report is always written to data/bugs/open/BUG-<date>-<n>/ first. Email is
# a notification on top of that, never the record itself: if delivery fails the
# report is still on disk and the interface says so rather than claiming it was
# sent. Leave SMTP_HOST or BUG_REPORT_EMAIL_TO empty to store reports only.
BUG_REPORT_EMAIL_TO=
BUG_REPORT_EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=

# Secret, like GROQ_API_KEY: .env only, never committed, never written into a
# bug report or a log line.
SMTP_PASSWORD=

# Port 465 implies implicit TLS and ignores this; 587 uses STARTTLS.
# SMTP_USE_TLS is accepted as a synonym.
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Source history
# ---------------------------------------------------------------------------

# How long versions of an official page are kept. History is what makes a
# question about the past answerable, and what a rollback returns to.
RETENTION_DAYS=90
RETENTION_VERSIONS=20

# How much history counts as *enough* to answer a historical question. This is
# deliberately a separate number: keeping versions is cheap, accumulating
# enough of them to be useful takes weeks. Below this, the production report
# says the capability works but the data is too shallow — rather than implying
# the archive is deeper than it is.
MINIMUM_HISTORICAL_DAYS=30
MINIMUM_HISTORICAL_VERSIONS=3

# ---------------------------------------------------------------------------
# Process switches (optional)
# ---------------------------------------------------------------------------
# Read by the process that needs them rather than by config.py, so they are
# shown commented out. Set them in the environment when you need them.
#
# ADMINTRACE_APP_HOST=127.0.0.1          # bind address; keep it local
# ADMINTRACE_APP_PORT=7860
# ADMINTRACE_CONCURRENCY=8               # answers served at once
# ADMINTRACE_TRACE_CONVERSATION=0        # 1 prints clarification state (developers)
#
# ADMINTRACE_NETWORK_TESTS=0             # 1 lets tests reach the live web
# ADMINTRACE_BROWSER_TESTS=0             # 1 runs the browser suite (starts the app)
# ADMINTRACE_TEST_PORT=                  # pin the browser-suite port
# APP_START_TIMEOUT_SECONDS=60
# ADMINTRACE_ANSWER_TIMEOUT_MS=120000    # raise for a slow local model
